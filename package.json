{
  "name": "pre-check-page-shares",
  "version": "0.7.2",
  "description": "Firefox extension: before you post a link, check whether the page has already been shared on Hacker News, Lemmy, Lobsters, Mastodon or Reddit.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Graham Perrin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamperrin/pre-check-page-shares.git"
  },
  "homepage": "https://github.com/grahamperrin/pre-check-page-shares#readme",
  "bugs": {
    "url": "https://github.com/grahamperrin/pre-check-page-shares/issues"
  },
  "scripts": {
    "test": "node test/run.js",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "start": "web-ext run --source-dir src"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "web-ext": "^10.7.0"
  }
}
